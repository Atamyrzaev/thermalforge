{
  "case": {
    "name": "passive-lowpower",
    "purpose": "the default operating point -- the passive-lowpower preset (12 W, h = 1000 W/m^2K) on the 20 x 20 mm reference package",
    "expect_threshold_exceeded": false
  },
  "grid": {
    "nx": 40,
    "ny": 40,
    "nz": 12,
    "dx": 0.0005,
    "dy": 0.0005,
    "dz": 2e-05
  },
  "boundary_conditions": {
    "t_ambient_c": 25.0,
    "h_convective": 1000.0,
    "bottom_bc": "neumann",
    "top_bc": "robin",
    "side_bc": "neumann"
  },
  "stack": {
    "interposer_um": 100.0,
    "bump_um": 40.0,
    "die_um": 100.0
  },
  "power": {
    "die_power_w": 12.0,
    "die_footprint_frac": 0.5
  },
  "solver": {
    "method": "explicit",
    "steady_state": false,
    "total_time_s": null,
    "dt": null,
    "safety_factor": 0.9,
    "record_steps": 50,
    "max_steps": 2000000
  },
  "visualization": {
    "output_dir": "outputs",
    "hotspot_threshold_c": 85.0,
    "use_pyvista": true
  }
}
