{
  "case": {
    "name": "passive-lowpower",
    "purpose": "the default operating point -- the passive-lowpower preset (12 W, h = 1000 W/m^2K) on the 20 x 20 mm reference package, with the four-block catalog at an explicit initial placement",
    "expect_threshold_exceeded": false
  },
  "chiplets": [
    {"id": "cpu0", "name": "CPU_Core",        "width_um": 4000.0,  "height_um": 4000.0,  "power_w": 3.333333333333333},
    {"id": "gpu0", "name": "GPU_Core",        "width_um": 6000.0,  "height_um": 5000.0,  "power_w": 4.666666666666666},
    {"id": "hbm0", "name": "HBM_Memory",      "width_um": 11000.0, "height_um": 11000.0, "power_w": 1.3333333333333333},
    {"id": "npu0", "name": "NPU_Accelerator", "width_um": 5000.0,  "height_um": 5000.0,  "power_w": 2.6666666666666665}
  ],
  "initial_placement": {
    "pitch_um": 2000.0,
    "origins_um": {
      "hbm0": [0.0, 0.0],
      "gpu0": [12000.0, 0.0],
      "npu0": [0.0, 12000.0],
      "cpu0": [6000.0, 12000.0]
    }
  },
  "grid": {
    "nx": 40,
    "ny": 40,
    "nz": 12,
    "dx": 0.0005,
    "dy": 0.0005,
    "dz": 2e-05
  },
  "boundary_conditions": {
    "t_ambient_c": 25.0,
    "h_convective": 1000.0,
    "bottom_bc": "neumann",
    "top_bc": "robin",
    "side_bc": "neumann"
  },
  "stack": {
    "interposer_um": 100.0,
    "bump_um": 40.0,
    "die_um": 100.0
  },
  "power": {
    "die_power_w": 12.0,
    "die_footprint_frac": 0.5
  },
  "solver": {
    "method": "explicit",
    "steady_state": false,
    "total_time_s": null,
    "dt": null,
    "safety_factor": 0.9,
    "record_steps": 50,
    "max_steps": 2000000
  },
  "visualization": {
    "output_dir": "outputs",
    "hotspot_threshold_c": 85.0,
    "use_pyvista": true
  }
}
